# Zotero executable used by `npm start`
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = D:\\apps\\zotero\\zotero.exe

# Use a dedicated development profile. Do not point this at your daily profile.
ZOTERO_PLUGIN_PROFILE_PATH = D:\\path\\to\\zotero-dev-profile

# Optional isolated Zotero data directory for development.
ZOTERO_PLUGIN_DATA_DIR = D:\\path\\to\\zotero-dev-data

